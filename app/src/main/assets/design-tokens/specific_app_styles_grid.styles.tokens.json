{
  "ds-grid-base-app": {
    "$type": "grid",
    "$value": [
      {
        "pattern": "columns",
        "visible": true,
        "alignment": "stretch",
        "color": "#ffd96480",
        "gutterSize": "{ds.layout.gutter}",
        "count": "{ds.layout.columns}",
        "offset": "{ds.layout.margin}"
      }
    ]
  }
}